# --- Telegram ---
BOT_TOKEN=123456:your-telegram-bot-token
BOT_USERNAME=HelaBot

# --- Access control: comma-separated Telegram numeric user IDs ---
OWNER_IDS=111111111
DEVELOPER_IDS=
SUPPORT_STAFF_IDS=

# --- Database (docker-compose overrides this to point at the postgres service) ---
DATABASE_URL=postgresql+asyncpg://hela:hela@localhost:5432/hela

# --- Redis (docker-compose overrides this to point at the redis service) ---
REDIS_URL=redis://localhost:6379/0

# --- Runtime ---
MAINTENANCE_MODE=false
LOG_LEVEL=INFO
DEFAULT_LOCALE=en

# --- Dashboard / API ---
API_SECRET_KEY=change-me
API_PORT=8080

# --- Economy tuning ---
DAILY_REWARD_MIN=100
DAILY_REWARD_MAX=500
WORK_REWARD_MIN=20
WORK_REWARD_MAX=150
WORK_COOLDOWN_SECONDS=1800
