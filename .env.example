# --- Telegram ---
BOT_TOKEN=123456:your-telegram-bot-token
BOT_USERNAME=HelaBot

# --- Access control: comma-separated Telegram numeric user IDs ---
OWNER_IDS=111111111
DEVELOPER_IDS=
SUPPORT_STAFF_IDS=

# --- Database ---
# Plain postgres:// or postgresql:// URLs (Neon, Railway, Heroku, Supabase...)
# are automatically rewritten to postgresql+asyncpg:// with a compatible
# query string at startup - see core/config.py normalize_database_url().
# You do NOT need to hand-edit sslmode/channel_binding yourself.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Redis ---
REDIS_URL=redis://default:password@host:port

# --- Runtime ---
MAINTENANCE_MODE=false
LOG_LEVEL=INFO
DEFAULT_LOCALE=en

# --- Dashboard / API ---
API_SECRET_KEY=change-me
API_PORT=8080

# --- Economy tuning ---
DAILY_REWARD_MIN=100
DAILY_REWARD_MAX=500
WORK_REWARD_MIN=20
WORK_REWARD_MAX=150
WORK_COOLDOWN_SECONDS=1800

# --- RPG tuning ---
ADVENTURE_COOLDOWN_SECONDS=1200
HUNT_COOLDOWN_SECONDS=600
FIGHT_COOLDOWN_SECONDS=900

# --- Gambling tuning ---
LOTTERY_TICKET_PRICE=50
